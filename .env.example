# Copy to .env (or just export these) before running the demos.

# ai-coustics SDK license key, used by every demo. Runs Tyto, and the VAD that
# does the agent's turn-taking.
# Get one at https://developers.ai-coustics.com
AIC_SDK_LICENSE=

# Inkling-Small, the agent's brain: it hears the user's audio and replies in
# text. A Thinking Machines key, served over their OpenAI-compatible endpoint.
INKLING_API_KEY=

# Deepgram, the agent's voice (Aura-2 text-to-speech) and the user transcript
# shown in the UI. Get one at https://console.deepgram.com
DEEPGRAM_API_KEY=

# Only needed to run the alternative OpenAI Realtime provider instead of the
# cascade. The demos do not use it.
# OPENAI_API_KEY=
