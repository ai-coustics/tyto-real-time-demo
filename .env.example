# Copy to .env (or just export these) before running the demo.

# ai-coustics SDK license key. Runs Tyto 1.1 on this machine, scoring the
# user's microphone. Get one at https://developers.ai-coustics.com
AIC_SDK_LICENSE=

# Deepgram. Two services, one key: Flux on the way in (transcription and turn
# detection) and Aura-2 on the way out (the agent's voice).
# Get one at https://console.deepgram.com
DEEPGRAM_API_KEY=

# OpenAI. gpt-5-mini is the brain in the middle of the cascade.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
