# Copy to .env (or just export these) before running the demos.

# ai-coustics SDK license key, used by every demo to run Tyto.
# Get one at https://developers.ai-coustics.com
AIC_SDK_LICENSE=

# OpenAI API key, used by the voice agent (examples/voice_agent.py, examples/web).
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Vercel AI Gateway key: runs Jev (TypeSafe AI) as the judge of the Reactive layer,
# billed to your gateway account. Optional: without it the tuned rule nudges alone.
# Get one at https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=

# Optional knobs (defaults shown).
# VOICE_BACKEND=live        # live = GPT-Live 1 (default), realtime = gpt-realtime-2.1
# LIVE_VOICE=marin          # GPT-Live voice (marin, cedar)
# TYPESAFE_API_KEY=         # Jev direct from TypeSafe instead of the gateway
