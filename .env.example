# Copy to .env (or just export these) before running the demos.

# ai-coustics SDK license key. Runs Tyto, and the optional Quail Voice Focus
# enhancement. Get one at https://developers.ai-coustics.com
AIC_SDK_LICENSE=

# Deepgram: Flux on the way in (transcription and turn-taking) and Aura-2 on
# the way out (the agent's voice). Get one at https://console.deepgram.com
DEEPGRAM_API_KEY=

# Which brain answers. "gpt-5-mini" (default) or "phonellm".
LLM_BACKEND=gpt-5-mini

# --- LLM_BACKEND=gpt-5-mini ------------------------------------------------- #
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- LLM_BACKEND=phonellm --------------------------------------------------- #
# Pipecat PhoneLLM on a Modal Auto Endpoint. Create it with:
#   modal workspace proxy-tokens create      # do this FIRST, or the next fails
#   modal endpoint create --model pipecat-ai/phonellm-alpha-1
# The URL is printed there, and is on the endpoint's page in the Modal
# dashboard afterwards (modal endpoint list shows status but not the URL).
#
# Note: Auto Endpoints scale to zero, and a cold 30B model took about 100
# seconds to answer here. Keep a container warm if anyone is watching.
MODAL_ENDPOINT_URL=
# The workspace proxy token, as <token-id>.<token-secret> (wk-....ws-...).
# On RBAC workspaces also run: modal workspace proxy-tokens allow <id> main
MODAL_API_KEY=
