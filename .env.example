# Copy to .env (or just export these) before running the demos.

# ai-coustics SDK license key, used by every demo to run Tyto.
# Get one at https://developers.ai-coustics.com
AIC_SDK_LICENSE=

# Pipecat PhoneLLM, the agent's brain, served from a Modal Auto Endpoint.
# Create it with:  modal endpoint create --model pipecat-ai/phonellm-alpha-1
# The URL is printed there, and is on the endpoint's page in the Modal
# dashboard afterwards (modal endpoint list shows status but not the URL).
MODAL_ENDPOINT_URL=

# The workspace proxy token the bot authenticates with, as <token-id>.<secret>
# (wk-....ws-...). Create it with:  modal workspace proxy-tokens create
# On RBAC workspaces also run:      modal workspace proxy-tokens allow <id> main
MODAL_API_KEY=

# Deepgram: Flux on the way in (transcription and turn-taking) and Aura-2 on
# the way out (the agent's voice). Get one at https://console.deepgram.com
DEEPGRAM_API_KEY=

# Only needed to run the alternative OpenAI Realtime provider instead of the
# cascade. The demos do not use it.
# OPENAI_API_KEY=
